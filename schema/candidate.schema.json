{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "target_user": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "enum": [
        "explore",
        "validate",
        "experiment",
        "watch",
        "reject"
      ]
    },
    "solution_directions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment": {
      "type": "object",
      "properties": {
        "criteria_version": {
          "const": "2.0"
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "human_importance": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "founder_pull": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "ai_leverage": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "evidence_quality": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "problem_intensity": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "existing_behavior_or_spend": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "distribution": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "monetization": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "competition_gap": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "buildability": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "human_importance",
            "founder_pull",
            "ai_leverage",
            "evidence_quality",
            "problem_intensity",
            "existing_behavior_or_spend",
            "distribution",
            "monetization",
            "competition_gap",
            "buildability"
          ]
        },
        "founder_feedback_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "criteria_version",
        "dimensions",
        "founder_feedback_id",
        "rationale"
      ]
    },
    "validation_gates": {
      "type": "object",
      "properties": {
        "human_importance": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "founder_pull": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "ai_leverage": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "evidence": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "alternative_failure": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "behavior": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "distribution": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "monetization": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "disconfirmation": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        }
      },
      "required": [
        "human_importance",
        "founder_pull",
        "ai_leverage",
        "evidence",
        "alternative_failure",
        "behavior",
        "distribution",
        "monetization",
        "disconfirmation"
      ]
    },
    "feedback_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "source_kind": {
            "enum": [
              "historical_report",
              "vendor_claim",
              "customer_behavior",
              "research",
              "official_doc",
              "user_observation"
            ]
          },
          "source_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "verified",
              "unverified",
              "inaccessible",
              "contradicted"
            ]
          },
          "independence_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "stance": {
            "enum": [
              "supports",
              "against",
              "context"
            ]
          },
          "contradicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "evidence_id",
          "source_url",
          "source_kind",
          "source_date",
          "retrieved_at",
          "claim",
          "interpretation",
          "verification",
          "independence_key",
          "confidence",
          "stance",
          "contradicts"
        ]
      }
    },
    "validation_experiment": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_reports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_step": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "title",
    "problem",
    "target_user",
    "stage",
    "solution_directions",
    "assessment",
    "validation_gates",
    "feedback_ids",
    "evidence",
    "validation_experiment",
    "source_reports",
    "next_step",
    "updated_at",
    "decision_reason"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
