{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem Hunter Candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "title",
    "problem",
    "target_user",
    "evidence",
    "validation_experiment"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 3},
    "title": {"type": "string"},
    "problem": {"type": "string"},
    "target_user": {"type": "string"},
    "economic_buyer": {"type": ["string", "null"]},
    "job_to_be_done": {"type": "string"},
    "solution_wedge": {"type": "string"},

    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "url", "summary"],
        "properties": {
          "date": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "url": {"type": "string"},
          "summary": {"type": "string"},
          "quote": {"type": ["string", "null"]},
          "context": {"type": ["string", "null"]},
          "customer_profile": {"type": ["string", "null"]},
          "evidence_type": {
            "type": "string",
            "enum": ["explicit_demand", "pain", "workaround", "switching", "timing", "spend", "other"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "observed_vs_inferred": {
            "type": "string",
            "enum": ["observed", "inferred", "mixed"]
          }
        }
      }
    },

    "trigger_events": {"type": "array", "items": {"type": "string"}},
    "desired_outcomes": {"type": "array", "items": {"type": "string"}},
    "customer_language": {"type": "array", "items": {"type": "string"}},
    "existing_spend_workarounds": {"type": "array", "items": {"type": "string"}},

    "switching_dynamics": {
      "type": "object",
      "properties": {
        "push": {"type": "array", "items": {"type": "string"}},
        "pull": {"type": "array", "items": {"type": "string"}},
        "habit": {"type": "array", "items": {"type": "string"}},
        "anxiety": {"type": "array", "items": {"type": "string"}}
      }
    },

    "competitors": {"type": "array", "items": {"type": "string"}},
    "competition_note": {"type": "string"},
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["direct", "secondary", "manual", "do_nothing"]},
          "pricing": {"type": ["string", "null"]},
          "strengths": {"type": "array", "items": {"type": "string"}},
          "customer_complaints": {"type": "array", "items": {"type": "string"}},
          "source_urls": {"type": "array", "items": {"type": "string"}}
        }
      }
    },

    "monetization": {"type": "string"},
    "pricing_hypothesis": {
      "type": "object",
      "properties": {
        "next_best_alternative": {"type": ["string", "null"]},
        "current_spend_or_cost": {"type": ["string", "null"]},
        "value_metric": {"type": ["string", "null"]},
        "test_price": {"type": ["string", "null"]},
        "learning_goal": {"type": ["string", "null"]}
      }
    },

    "acquisition": {"type": "string"},
    "first_customer_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_url", "signal"],
        "properties": {
          "prospect": {"type": ["string", "null"]},
          "source_url": {"type": "string"},
          "date": {"type": ["string", "null"]},
          "signal": {"type": "string"},
          "stage": {
            "type": "string",
            "enum": ["high_intent", "problem_aware", "trigger_present", "potential_fit"]
          },
          "channel": {"type": ["string", "null"]},
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },

    "validation_offer": {
      "type": "object",
      "properties": {
        "core_deliverable": {"type": ["string", "null"]},
        "dream_outcome": {"type": ["string", "null"]},
        "time_to_first_value": {"type": ["string", "null"]},
        "customer_effort": {"type": ["string", "null"]},
        "risk_reversal": {"type": ["string", "null"]},
        "test_price": {"type": ["string", "null"]},
        "cta": {"type": ["string", "null"]}
      }
    },

    "validation_experiment": {"type": "string"},
    "validation_gates": {
      "type": "object",
      "properties": {
        "research_quality": {"type": "boolean"},
        "competition_gap": {"type": "boolean"},
        "monetization": {"type": "boolean"},
        "reachability": {"type": "boolean"},
        "disconfirmation": {"type": "boolean"}
      }
    },

    "risks": {"type": "array", "items": {"type": "string"}},
    "next_step": {"type": "string"},
    "status": {"type": "string"},
    "score": {"type": "number", "minimum": 0, "maximum": 100}
  }
}
